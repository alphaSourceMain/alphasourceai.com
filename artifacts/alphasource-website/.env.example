# LinkedIn Insight Tag partner ID from Campaign Manager.
# Leave this empty to skip the tag entirely. Do not commit a real ID.
#
# Render must set VITE_LINKEDIN_PARTNER_ID as a build-time environment variable.
# Vite inlines VITE_* values when the site is built, so a runtime-only value
# is not visible in the browser until the next build.
VITE_LINKEDIN_PARTNER_ID=
